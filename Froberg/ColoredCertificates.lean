theorem all_patterns_represented : certifiedPatterns.map Sigma.fst = patterns := by
  decide +kernel

theorem patterns_length : patterns.length = 275 := by decide +kernel

/-- Every canonical graph admits the explicitly certified full matching. -/
theorem every_pattern_has_matching (p : Pattern) (hp : p ∈ patterns) :
    ∃ es : List Entry, ValidCertificate p es := by
  rw [← all_patterns_represented] at hp
  obtain ⟨r, _, hr⟩ := List.mem_map.mp hp
  subst p
  exact ⟨r.2.1, r.2.2⟩

end Froberg.ColoredGraph
