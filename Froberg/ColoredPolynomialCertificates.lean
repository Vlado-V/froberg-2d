theorem all_algebraic_patterns_represented : algebraicPatterns.map Sigma.fst = patterns := by
  decide +kernel

/-- Every canonical graph yields a nonzero coefficient-polynomial minor. -/
theorem every_pattern_has_nonzero_minor {K : Type*} [CommRing K] [Nontrivial K]
    (p : Pattern) (hp : p ∈ patterns) :
    ∃ es : List Entry, ValidCertificate p es ∧
      (ProductMinors.productMinor (K := K) coloredTerms
        (fun i : Fin es.length => es[i].left.semantic) (fun i : Fin es.length => es[i].right.semantic)
        (fun i : Fin es.length => es[i].productExponent)).det ≠ 0 := by
  rw [← all_algebraic_patterns_represented] at hp
  obtain ⟨r,_,hr⟩ := List.mem_map.mp hp
  subst p
  exact ⟨r.2.1,r.2.2.1,algebraicCertificate_minor r.2.1 r.2.2.2⟩

