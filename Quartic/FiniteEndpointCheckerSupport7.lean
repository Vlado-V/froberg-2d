def selected (i : Fin 210) : Fin 9 × Fin 28 := selectedData[i.val]?.getD (0,0)
theorem product_variable_lists : ∀ i : Fin 210, (rows i).map vars4 = (quadSupport (selected i).1).map (fun j => (vars2 j ++ vars2 (selected i).2).insertionSort (· ≤ ·)) := by decide
theorem product_supports (i : Fin 210) : (rows i).map exponent4 = (quadSupport (selected i).1).map (fun j => exponent2 j + exponent2 (selected i).2) := support_identity_of_lists vars4 vars2 (vars2 (selected i).2) (rows i) (quadSupport (selected i).1) (product_variable_lists i)
theorem lower_selected : ∀ i : Fin 196, (selected ⟨i.val, by omega⟩).1.val < 8 := by decide
def quadColumnsData : Array (Fin 28) := #[26,27,25,24,21,23,22,18,20]
