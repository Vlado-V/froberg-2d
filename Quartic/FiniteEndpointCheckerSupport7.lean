def quadInverseData : Array Nat := #[344,322,328,98,345,34,193,140,461]
def quadInverse (i : Fin 9) : Nat := quadInverseData[i.val]?.getD 0
theorem quad_inverse_checked : Quartic.FiniteEndpointChecker.checkInverse quadMinor quadInverse = true := by decide
theorem quad_coefficient_counts : ∀ i j : Fin 9, (quadSupport i).count (quadColumns j) = (quadMinor i).count j := by decide
