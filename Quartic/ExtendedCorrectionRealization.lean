module

public import Quartic.ExtendedMovingCorrection
public import Quartic.ExceptionalDeformationColumn

/-! Every coefficient in the extended moving correction space is realized
by a persistent polynomial column. The ordinary part uses two cancellations;
the additional part uses the checked fourth-order square correction. -/

@[expose] public section

noncomputable section
namespace Quartic.ExtendedCorrectionRealization
open Module ActualDeformationColumnsOmega HomologyCoordinates

variable {K : Type*} [Field K] {m c q : ℕ}

def responseSpace (ω : K) (g : Fin c → MiddleCoordinates.Mixed K m)
    (h : Fin q → Forms K m 2) (p : Fin c → Forms K m 2)
    (r : Fin 4 → Forms K m 2) (k : Fin q) : Submodule K (ActualSplitCokernel.RawJ g h) :=
  (PersistentColumnRank.persistent
    (quadraticMultiplication (SplitBlock22.fullGenerators g h))
    (quadraticMultiplication (motionFamily p r (Pi.single k (markedDirection ω))))).map
      (projectionRawJ g h)

def rawResponse (g : Fin c → MiddleCoordinates.Mixed K m) (h : Fin q → Forms K m 2)
    (p : Fin c → Forms K m 2) :
    (Fin c → MiddleCoordinates.Mixed K m) →ₗ[K] ActualSplitCokernel.RawJ g h :=
  (GeneralF13.combined g h).range.mkQ.comp
    (∑ i, (RowMultiplicationCoordinates.multiplication (p i)).comp (LinearMap.proj i))

@[simp] theorem rawResponse_apply (g : Fin c → MiddleCoordinates.Mixed K m)
    (h : Fin q → Forms K m 2) (p : Fin c → Forms K m 2)
    (z : Fin c → MiddleCoordinates.Mixed K m) :
    rawResponse g h p z = (GeneralF13.combined g h).range.mkQ
      (∑ i, RowMultiplicationCoordinates.multiplication (p i) (z i)) := by
  simp [rawResponse]

theorem ordinary_mem (ω : K) (g : Fin c → MiddleCoordinates.Mixed K m)
    (h : Fin q → Forms K m 2) (p : Fin c → Forms K m 2)
    (r : Fin 4 → Forms K m 2) (k : Fin q)
    (U : Submodule K (Forms K m 2 ⧸ Submodule.span K (Set.range h)))
    (hmarked : MarkedRepresentatives h k U)
    (z : (MovingMiddleCorrectionOmega.traceSpace ω h r U).comap
      (MiddleCoordinates.quotientMap g (Submodule.span K (Set.range h)))) :
    rawResponse g h p z.val ∈ responseSpace ω g h p r k := by
  obtain ⟨a, b, ha, hb, _, hr⟩ := correction_response_realized ω g h p r k U hmarked z
  refine ⟨_, PersistentColumnRank.second_response_mem _ _ a b ha hb, ?_⟩
  simpa only [rawResponse_apply, ActualDeformationResponseOmega.correctionResponse_mk] using hr

theorem exceptional_mem (ω : K) (g : Fin c → MiddleCoordinates.Mixed K m)
    (h : Fin q → Forms K m 2) (p : Fin c → Forms K m 2)
    (r : Fin 4 → Forms K m 2) (k : Fin q)
    (a : (quadraticMultiplication h).ker) (ha : a.val k = h k)
    (z : Fin c → MiddleCoordinates.Mixed K m)
    (hz : MiddleCoordinates.quotientMap g (Submodule.span K (Set.range h)) z =
      -((ω ^ 2) • (Submodule.span K (Set.range h)).mkQ (r 3),
          (Submodule.span K (Set.range h)).mkQ (r 3))) :
    rawResponse g h p z ∈ responseSpace ω g h p r k := by
  have hz' : MiddleCoordinates.quotientMap g (Submodule.span K (Set.range h)) z =
      -SplitBlock22.elimination (Submodule.span K (Set.range h))
        (pureFirstResponse r (ExceptionalDeformationColumn.pureCorrection ω)) := by
    rw [ExceptionalDeformationColumn.pureCorrection_elimination]
    exact hz
  obtain ⟨w, hw, hr⟩ := ExceptionalDeformationColumn.response_realized ω g h p r k a ha z hz'
  refine ⟨w, ?_, ?_⟩
  · apply (PersistentColumnRank.mem_persistent _ _ w).mpr
    intro ε he
    simpa only [deformed_multiplication] using hw ε he
  · simpa only [rawResponse_apply] using hr

/-- The entire extended preimage is generated by ordinary corrections and one exceptional lift. -/
theorem extended_mem (ω : K) (g : Fin c → MiddleCoordinates.Mixed K m)
    (h : Fin q → Forms K m 2) (p : Fin c → Forms K m 2)
    (r : Fin 4 → Forms K m 2) (k : Fin q)
    (U : Submodule K (Forms K m 2 ⧸ Submodule.span K (Set.range h)))
    (hmarked : MarkedRepresentatives h k U)
    (hs : Function.Surjective
      (MiddleCoordinates.quotientMap g (Submodule.span K (Set.range h))))
    (a : (quadraticMultiplication h).ker) (ha : a.val k = h k)
    (z : (ExtendedMovingCorrection.traceSpace ω h r U).comap
      (MiddleCoordinates.quotientMap g (Submodule.span K (Set.range h)))) :
    rawResponse g h p z.val ∈ responseSpace ω g h p r k := by
  let Q := Submodule.span K (Set.range h)
  let e := ((ω ^ 2) • Q.mkQ (r 3), Q.mkQ (r 3))
  obtain ⟨ze, hze⟩ := hs (-e)
  have heMem := exceptional_mem ω g h p r k a ha ze hze
  obtain ⟨⟨u, t⟩, ht⟩ := z.property
  let v : Fin 3 → K := ![t 0, t 1, t 2]
  have htrace : ExtendedMovingCorrection.traceMap ω (fun i => Q.mkQ (r i)) U (u, t) =
      MovingMiddleCorrectionOmega.traceMap ω (fun i => Q.mkQ (r i)) U
        (u, homologyEquiv v) + t 3 • e := by
    apply Prod.ext <;>
      simp [ExtendedMovingCorrection.traceMap_apply, MovingMiddleCorrectionOmega.traceMap_apply,
        ExtendedPureTrace.trace, AugmentedMiddle.pureTrace, homologyEquiv,
        homologyReduction_cycleClasses, ThreeBlock.coefficientMaps, Fin.sum_univ_succ,
        v, e, smul_smul] <;> module
  have hzo : z.val + t 3 • ze ∈ (MovingMiddleCorrectionOmega.traceSpace ω h r U).comap
      (MiddleCoordinates.quotientMap g Q) := by
    refine ⟨(u, homologyEquiv v), ?_⟩
    rw [map_add, map_smul, hze, ← ht, htrace]
    module
  have ho := ordinary_mem ω g h p r k U hmarked ⟨z.val + t 3 • ze, hzo⟩
  have hd := (responseSpace ω g h p r k).sub_mem ho
    ((responseSpace ω g h p r k).smul_mem (t 3) heMem)
  change rawResponse g h p (z.val + t 3 • ze) -
    t 3 • rawResponse g h p ze ∈ responseSpace ω g h p r k at hd
  rwa [map_add, map_smul, add_sub_cancel_right] at hd

end Quartic.ExtendedCorrectionRealization
